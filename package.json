{
  "name": "slipgate",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "SLIPGATE — двумерный шутер в духе Quake 1 на чистом JavaScript и Canvas 2D",
  "scripts": {
    "test": "npm run test:levels && npm run test:game",
    "test:levels": "node tools/check-levels.js && python3 tools/levelgen/build_levels.py --check",
    "test:game": "node tests/run.js",
    "levels": "python3 tools/levelgen/build_levels.py",
    "build": "node tools/build.js",
    "app": "node tools/build.js --app",
    "serve": "node tools/serve.js dist/app"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
